# Local: your own Postgres connection (e.g. a Neon branch).
# Production (Vercel): injected automatically by Vercel when you connect the
# Neon integration from the Storage tab. No need to set it by hand.
DATABASE_URL="postgres://usuari:contrasenya@host/tebasfury"

# Generate it with: openssl rand -base64 32
# Production: must be a different secret from the local one.
BETTER_AUTH_SECRET="generate one with: openssl rand -base64 32"

# Local: http://localhost:3000
# Production: the public URL of the deployment on Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# "Web application" type OAuth 2.0 client in the Google Cloud Console.
# Authorized redirect URIs (both need to be added):
#   http://localhost:3000/api/auth/callback/google
#   https://<vercel-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Who may sign in. Google's consent screen does not gate this app — it asks only for
# non-sensitive scopes, so the test-user list does not apply — and the allowlist below
# is the only thing keeping the league private.
#
# ADMIN_EMAIL is required and is ALWAYS admitted, whatever LEAGUE_ALLOWLIST says. It is
# a separate variable so that a typo in the list cannot lock out the person who would
# have to correct it.
ADMIN_EMAIL=""
#
# LEAGUE_ALLOWLIST is comma-separated. Unset or empty means ADMIN_EMAIL and nobody else.
# Spaces and a trailing comma are harmless; capitalisation does not matter.
#
# WARNING: Gmail treats "j.oan@gmail.com" and "joan@gmail.com" as the same account and
# this list does not. Copy each address as the person actually writes it. If a friend is
# turned away and swears they are on the list, compare the dots first.
LEAGUE_ALLOWLIST=""

# 32-byte key, base64, sealing the stored LaLiga refresh token.
# Generate with: openssl rand -base64 32
# Must differ per environment. Losing it means re-bootstrapping the credential.
CREDENTIALS_KEY=""

# The private league's id, as the LaLiga Fantasy API reports it.
# Find it with: GET /v1/competition/1/leagues (see spike/README.md)
LALIGA_LEAGUE_ID=""

# From the Upstash console (https://console.upstash.com/qstash): the QStash
# tab gives the token and both signing keys.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# See docs/deployment.md for the full deployment procedure.
