# Local: connexió pròpia a Postgres (p. ex. una branca de Neon).
# Producció (Vercel): la injecta Vercel automàticament en connectar la
# integració de Neon des de la pestanya Storage. No cal definir-la a mà.
DATABASE_URL="postgres://usuari:contrasenya@host/tebasfury"

# Genera'l amb: openssl rand -base64 32
# Producció: ha de ser un secret diferent del de local.
BETTER_AUTH_SECRET="genera'l amb: openssl rand -base64 32"

# Local: http://localhost:3000
# Producció: la URL pública del desplegament a Vercel.
BETTER_AUTH_URL="http://localhost:3000"

# Client OAuth 2.0 de tipus "aplicació web" a la Google Cloud Console.
# URI de redirecció autoritzats (cal afegir-hi els dos):
#   http://localhost:3000/api/auth/callback/google
#   https://<domini-de-vercel>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vegeu docs/desplegament.md per al procediment complet de desplegament.
